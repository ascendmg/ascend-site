{
    "cleanUrls": true,
    "trailingSlash": false,
    "crons": [
          {
                  "path": "/api/cron/weekly-audit",
                  "schedule": "0 8 * * 1"
          }
    ],
    "headers": [
          {
                  "source": "/(.*)",
                  "has": [{ "type": "header", "key": "accept", "value": "(.*text/html.*)" }],
                  "headers": [
                            { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
                  ]
          }
    ]
}
