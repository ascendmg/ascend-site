{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/weekly-audit",
      "schedule": "0 8 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*text/html.*)"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/manage-client",
      "destination": "/api/manage?fn=client"
    },
    {
      "source": "/api/manage-task",
      "destination": "/api/manage?fn=task"
    },
    {
      "source": "/api/approve-recommendation",
      "destination": "/api/seo?fn=approve"
    },
    {
      "source": "/api/generate-recommendations",
      "destination": "/api/seo?fn=recommendations"
    },
    {
      "source": "/api/generate-report",
      "destination": "/api/seo?fn=report"
    }
  ],
  "redirects": [
    {
      "source": "/pricing-ads",
      "destination": "/pricing?tab=marketing",
      "permanent": true
    },
    {
      "source": "/pricing-seo",
      "destination": "/pricing?tab=seo",
      "permanent": true
    },
    {
      "source": "/pricing-web-design",
      "destination": "/pricing?tab=web",
      "permanent": true
    }
  ]
}